@echo off
setlocal EnableExtensions
chcp 949 >nul
title 올투엠디 v3.3 (한글판)

rem ============================================================
rem  All_to_MD_v3_3_KR.bat  -  올투엠디 한글판 v3.3 (오프라인 배포형)
rem
rem  * 이 bat 옆의 engine 폴더에 필요한 모든 것을 모읍니다.
rem      engine\uv.exe, engine\python, engine\uv-cache,
rem      engine\Tesseract-OCR, engine\tessdata, engine\hnc2unicode.rb
rem  * engine\ready.txt 가 없으면 [최초 준비 모드]: 인터넷에서 내려받음
rem  * engine\ready.txt 가 있으면 [오프라인 모드]: 인터넷 없이 실행
rem  * 이 파일은 CP949(한글 윈도우 기본) 인코딩입니다.
rem    메모장으로 저장할 때 인코딩을 'ANSI'로 유지하세요.
rem ============================================================

set "BAT_SELF=%~f0"
set "ENGINE=%~dp0engine"
if not exist "%ENGINE%" mkdir "%ENGINE%" >nul 2>&1
set "TESS_DIR=%ENGINE%\tessdata"
if not exist "%TESS_DIR%" mkdir "%TESS_DIR%" >nul 2>&1
set "WORK_DIR=%TEMP%\AllToMD_v3"
if not exist "%WORK_DIR%" mkdir "%WORK_DIR%" >nul 2>&1

set "UV_CACHE_DIR=%ENGINE%\uv-cache"
set "UV_PYTHON_INSTALL_DIR=%ENGINE%\python"
set "UV_PYTHON_PREFERENCE=only-managed"
set "UV_LINK_MODE=copy"
set "PYTHONUTF8=1"
set "ALL2MD_ENGINE=%ENGINE%"
set "ALL2MD_LANG=kor+eng"
if exist "%ENGINE%\lang_full.txt" set "ALL2MD_LANG=kor+eng+grc+heb"
set "ALL2MD_PSM=6"
if exist "%ENGINE%\psm_auto.txt" set "ALL2MD_PSM=3"
set "ALL2MD_FORCE_OCR=0"
if exist "%ENGINE%\force_ocr.txt" set "ALL2MD_FORCE_OCR=1"

set "OFFLINE=0"
if exist "%ENGINE%\ready.txt" set "OFFLINE=1"
if "%OFFLINE%"=="1" set "UV_OFFLINE=1"
if "%OFFLINE%"=="1" set "UV_PYTHON_DOWNLOADS=never"

echo.
echo  ============================================================
echo   올투엠디 v3 (한글판) - 준비 단계
echo  ============================================================
if "%OFFLINE%"=="1" echo   [실행 방식] 오프라인 - engine 폴더의 구성요소만 사용합니다.
if "%OFFLINE%"=="0" echo   [실행 방식] 최초 준비 - 인터넷에서 구성요소를 내려받아 engine 폴더를 만듭니다.
echo.

rem ---------- ahwp.exe (선택: HWP 변환용) ----------
set "AHWP=%~dp0ahwp.exe"
if exist "%AHWP%" goto :ahwp_ready
set "AHWP=%ENGINE%\ahwp.exe"
if exist "%AHWP%" goto :ahwp_ready
set "AHWP="
:ahwp_ready

rem ---------- [1/5] uv.exe ----------
set "UV=%~dp0uv.exe"
if exist "%UV%" goto :uv_ready
set "UV=%ENGINE%\uv.exe"
if exist "%UV%" goto :uv_ready
if "%OFFLINE%"=="1" goto :engine_incomplete

echo [1/5] 파이썬 실행 엔진(uv.exe)을 내려받습니다...
del /q "%WORK_DIR%\uv.zip" >nul 2>&1
curl.exe -L -f --progress-bar -o "%WORK_DIR%\uv.zip" "https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-pc-windows-msvc.zip"
if exist "%WORK_DIR%\uv.zip" goto :extract_uv
echo   다른 방법(PowerShell)으로 다시 시도합니다...
powershell -NoProfile -Command "$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-pc-windows-msvc.zip' -OutFile '%WORK_DIR%\uv.zip'"

:extract_uv
if not exist "%WORK_DIR%\uv.zip" goto :uv_fail
powershell -NoProfile -Command "Expand-Archive -LiteralPath '%WORK_DIR%\uv.zip' -DestinationPath '%WORK_DIR%\uv_tmp' -Force; Get-ChildItem -LiteralPath '%WORK_DIR%\uv_tmp' -Filter 'uv.exe' -Recurse | Select-Object -First 1 | Move-Item -Destination '%ENGINE%\uv.exe' -Force; Remove-Item '%WORK_DIR%\uv.zip', '%WORK_DIR%\uv_tmp' -Recurse -Force"
if exist "%UV%" goto :uv_ready

:uv_fail
echo.
echo  [오류] uv.exe를 내려받지 못했습니다. 인터넷 연결을 확인해 주세요.
echo         (회사/교회 방화벽이 github.com 접속을 막고 있을 수도 있습니다.)
pause
exit /b 1

:uv_ready
echo [1/5] uv.exe 확인 완료

rem ---------- [2/5] Tesseract OCR ----------
set "TESS_EXE="
if exist "%ENGINE%\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%ENGINE%\Tesseract-OCR\tesseract.exe"
if not defined TESS_EXE if exist "%ProgramFiles%\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%ProgramFiles%\Tesseract-OCR\tesseract.exe"
if not defined TESS_EXE if exist "%LOCALAPPDATA%\Programs\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%LOCALAPPDATA%\Programs\Tesseract-OCR\tesseract.exe"
if defined TESS_EXE goto :tess_ready
if "%OFFLINE%"=="1" goto :engine_incomplete

echo [2/5] OCR 프로그램(Tesseract)을 내려받아 engine 폴더에 설치합니다...
del /q "%WORK_DIR%\tess_setup.exe" >nul 2>&1
curl.exe -L -f --progress-bar -o "%WORK_DIR%\tess_setup.exe" "https://github.com/tesseract-ocr/tesseract/releases/download/5.5.3/tesseract-ocr-w64-setup-5.5.3.20260724.exe"
if not exist "%WORK_DIR%\tess_setup.exe" goto :tess_fail
echo   설치 중입니다. 보안 확인창이 뜨면 [예]를 눌러 주세요.
start "" /wait "%WORK_DIR%\tess_setup.exe" /S /D=%ENGINE%\Tesseract-OCR
del /q "%WORK_DIR%\tess_setup.exe" >nul 2>&1
if exist "%ENGINE%\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%ENGINE%\Tesseract-OCR\tesseract.exe"
if defined TESS_EXE goto :tess_ready

:tess_fail
echo.
echo  [오류] Tesseract 설치에 실패했습니다.
echo         인터넷 연결을 확인하시고, 보안 확인창에서 [예]를 눌렀는지 확인해 주세요.
pause
exit /b 1

:tess_ready
echo [2/5] Tesseract 확인 완료

rem ---------- [3/5] OCR 언어 데이터 ----------
if "%OFFLINE%"=="0" goto :lang_download
for %%L in (kor eng grc heb) do if not exist "%TESS_DIR%\%%L.traineddata" goto :engine_incomplete
goto :lang_check

:lang_download
echo [3/5] OCR 언어 데이터(한글, 영어, 헬라어, 히브리어)를 확인합니다...
call :get_lang kor
call :get_lang eng
call :get_lang grc
call :get_lang heb

:lang_check
for %%L in (kor eng grc heb) do if not exist "%TESS_DIR%\%%L.traineddata" goto :lang_fail
echo [3/5] 언어 데이터 확인 완료

rem ---------- 구형 HWP용 변환표 (실패해도 계속 진행) ----------
if exist "%ENGINE%\hnc2unicode.rb" goto :hnc_ready
if "%OFFLINE%"=="1" goto :hnc_ready
curl.exe -s -L -f -o "%ENGINE%\hnc2unicode.rb" "https://raw.githubusercontent.com/ddoleye/java-hwp/master/src/main/resources/hnc2unicode.rb"
if errorlevel 1 del /q "%ENGINE%\hnc2unicode.rb" >nul 2>&1
:hnc_ready

rem ---------- [4/5] 파이썬 환경 점검 ----------
rem  오프라인 모드에서는 폴더를 옮겼을 때 꼬일 수 있는 임시 환경을 지우고 캐시에서 다시 만듭니다.
if "%OFFLINE%"=="1" for /d %%D in ("%UV_CACHE_DIR%\environments-v*") do rd /s /q "%%D" >nul 2>&1

echo [4/5] 파이썬 변환 환경을 점검합니다. (처음에는 몇 분 걸릴 수 있습니다)
"%UV%" run --python 3.12 --with pymupdf --with pillow --with python-docx --with olefile --with helper-hwp python -c "import pymupdf, PIL, docx, olefile"
if errorlevel 1 goto :py_fail
if "%OFFLINE%"=="0" echo ok>"%ENGINE%\ready.txt"
echo [4/5] 파이썬 환경 확인 완료
if "%OFFLINE%"=="0" echo       engine 폴더 준비가 끝났습니다. 이제 bat과 engine 폴더를 통째로 다른 PC에 복사해도 인터넷 없이 실행됩니다.

rem ---------- [5/5] 선택 화면 실행 ----------
echo   [OCR 언어] %ALL2MD_LANG%
echo   [페이지 분석] psm %ALL2MD_PSM%  (6 = 단 하나짜리 본문용, 3 = 자동. 2단 편집 책이면 engine 폴더에 psm_auto.txt 빈 파일을 만드세요)
if "%ALL2MD_LANG%"=="kor+eng" echo     (헬라어/히브리어까지 읽으려면 engine 폴더에 lang_full.txt 라는 빈 파일을 만드세요)
if "%ALL2MD_FORCE_OCR%"=="1" echo   [강제 OCR] PDF의 기존 글자층을 쓰지 않고 모든 쪽을 OCR합니다.
if "%ALL2MD_FORCE_OCR%"=="0" echo     (글자가 깨져 나오면 engine 폴더에 force_ocr.txt 라는 빈 파일을 만들어 보세요)
echo [5/5] 변환기를 시작합니다...
set "ALL2MD_UV=%UV%"
set "ALL2MD_PY=%WORK_DIR%\all_to_md_v3.py"
set "ALL2MD_TESS_EXE=%TESS_EXE%"
set "ALL2MD_TESS_DIR=%TESS_DIR%"
set "ALL2MD_AHWP=%AHWP%"
set "ALL2MD_BAT=%BAT_SELF%"
set "ALL2MD_STATE=%WORK_DIR%\target.txt"
set "ALL2MD_PS=%WORK_DIR%\picker_v3.ps1"

powershell -NoProfile -Command "$p=@(Get-Content -LiteralPath $env:ALL2MD_BAT); $i=[Array]::IndexOf($p, ':: ===PS_B64==='); if($i -lt 0){ exit 2 }; $b=($p[($i+1)..($p.Count-1)] | ForEach-Object { $_.Trim() }) -join ''; [IO.File]::WriteAllBytes($env:ALL2MD_PS, [Convert]::FromBase64String($b))"
if errorlevel 1 goto :ps_fail

set "TARGET_ARG=%~1"
powershell -NoProfile -STA -ExecutionPolicy Bypass -File "%ALL2MD_PS%" "%TARGET_ARG%"
goto :end

:get_lang
if exist "%TESS_DIR%\%~1.traineddata" goto :eof
echo   %~1.traineddata 내려받는 중...
curl.exe -L -f --progress-bar -o "%TESS_DIR%\%~1.traineddata" "https://github.com/tesseract-ocr/tessdata_best/raw/main/%~1.traineddata"
if errorlevel 1 del /q "%TESS_DIR%\%~1.traineddata" >nul 2>&1
goto :eof

:lang_fail
echo.
echo  [오류] OCR 언어 데이터를 내려받지 못했습니다. 인터넷 연결을 확인하고 다시 실행해 주세요.
pause
exit /b 1

:py_fail
echo.
echo  [오류] 파이썬 변환 환경을 만들지 못했습니다.
if "%OFFLINE%"=="1" echo         오프라인 모드인데 engine\uv-cache 또는 engine\python 이 불완전한 것 같습니다.
if "%OFFLINE%"=="1" echo         인터넷이 되는 PC에서 engine\ready.txt 를 지우고 다시 실행해 완성해 주세요.
if "%OFFLINE%"=="0" echo         인터넷 연결을 확인하고 다시 실행해 주세요.
pause
exit /b 1

:ps_fail
echo.
echo  [오류] 선택 화면 스크립트를 만들지 못했습니다. bat 파일이 손상되었을 수 있습니다.
pause
exit /b 1

:engine_incomplete
echo.
echo  [오류] 오프라인 모드인데 engine 폴더의 구성요소가 부족합니다.
echo         필요한 것: uv.exe, python, uv-cache, Tesseract-OCR, tessdata
echo         인터넷이 되는 PC에서 engine\ready.txt 를 지우고 이 bat을 한 번 실행해
echo         engine 폴더를 완성한 뒤, bat과 engine 폴더를 함께 복사해 주세요.
pause
exit /b 1

:end
echo.
pause
exit /b 0

