@echo off
setlocal EnableExtensions
title All to MD v3

rem ==========================================================
rem  All_to_MD_v3.bat   (2026-11-23)
rem
rem  HWP / HWPX / PDF / DOCX / TXT / HTML / pictures  ->  .md
rem    - folder job : the chosen folder and all its subfolders
rem                   -> md_output folder inside it
rem    - single file: one chosen file -> .md beside the file
rem    - you may also drop a file or a folder on this .bat
rem
rem  v3 change - the cp949 crash of v2 is fixed:
rem    v2 stopped with
rem      UnicodeEncodeError: 'cp949' codec can't encode
rem      character U+7955 (a hanja) at  print("[Fast] ...")
rem    when a file name held that hanja, a circled number or
rem    a middle dot. v3 switches the console to UTF-8 and sets
rem    PYTHONUTF8 / PYTHONIOENCODING before Python starts, and
rem    the converter script now hardens its own stdout/stderr
rem    and prints every message through a safe printer, so no
rem    file name can stop the run.
rem
rem  This file is plain ASCII with CRLF line endings, so a
rem  Korean Windows cmd.exe reads it safely. All dialogs and
rem  paths are handled by the PowerShell picker kept in the
rem  base64 block at the end of this file, never by cmd.exe.
rem ==========================================================

chcp 65001 >nul 2>nul
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"

set "CACHE_DIR=%LOCALAPPDATA%\PickleOCR"
if not exist "%CACHE_DIR%" mkdir "%CACHE_DIR%" >nul 2>&1
set "TESS_DIR=%CACHE_DIR%\tessdata"
if not exist "%TESS_DIR%" mkdir "%TESS_DIR%" >nul 2>&1

set "AHWP=%~dp0ahwp.exe"
if exist "%AHWP%" goto :ahwp_ready
set "AHWP=%CACHE_DIR%\ahwp.exe"
if exist "%AHWP%" goto :ahwp_ready
set "AHWP="
:ahwp_ready

set "UV=%~dp0uv.exe"
if exist "%UV%" goto :uv_ready
set "UV=%CACHE_DIR%\uv.exe"
if exist "%UV%" goto :uv_ready

echo [1/4] Downloading the portable Python engine (uv.exe)...
curl.exe -L -f --progress-bar -o "%CACHE_DIR%\uv.zip" "https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-pc-windows-msvc.zip"
if exist "%CACHE_DIR%\uv.zip" goto :extract_uv
echo Falling back to the Windows downloader...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-pc-windows-msvc.zip' -OutFile '%CACHE_DIR%\uv.zip'"

:extract_uv
if not exist "%CACHE_DIR%\uv.zip" goto :uv_fail
powershell -NoProfile -ExecutionPolicy Bypass -Command "Expand-Archive -LiteralPath '%CACHE_DIR%\uv.zip' -DestinationPath '%CACHE_DIR%\uv_tmp' -Force; Get-ChildItem -LiteralPath '%CACHE_DIR%\uv_tmp' -Filter 'uv.exe' -Recurse | Select-Object -First 1 | Move-Item -Destination '%CACHE_DIR%\uv.exe' -Force; Remove-Item -LiteralPath '%CACHE_DIR%\uv.zip','%CACHE_DIR%\uv_tmp' -Recurse -Force"
if exist "%UV%" goto :uv_ready

:uv_fail
echo.
echo [ERROR] Could not get uv.exe. Please check the internet connection
echo         and run this file again.
pause
exit /b 1

:uv_ready
:check_tess
set "TESS_EXE="
if exist "%CACHE_DIR%\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%CACHE_DIR%\Tesseract-OCR\tesseract.exe"
if not defined TESS_EXE if exist "%ProgramFiles%\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%ProgramFiles%\Tesseract-OCR\tesseract.exe"
if not defined TESS_EXE if exist "%LOCALAPPDATA%\Programs\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%LOCALAPPDATA%\Programs\Tesseract-OCR\tesseract.exe"
if defined TESS_EXE goto :check_lang

echo [2/4] Downloading Tesseract OCR (Korean + English + Greek + Hebrew)...
curl.exe -L -f --progress-bar -o "%CACHE_DIR%\tess_setup.exe" "https://github.com/tesseract-ocr/tesseract/releases/download/5.5.3/tesseract-ocr-w64-setup-5.5.3.20260724.exe"
if not exist "%CACHE_DIR%\tess_setup.exe" goto :tess_fail
echo Installing Tesseract OCR quietly...
"%CACHE_DIR%\tess_setup.exe" /S /D=%CACHE_DIR%\Tesseract-OCR
del /q "%CACHE_DIR%\tess_setup.exe" >nul 2>&1
if exist "%CACHE_DIR%\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%CACHE_DIR%\Tesseract-OCR\tesseract.exe"
if not defined TESS_EXE if exist "%ProgramFiles%\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%ProgramFiles%\Tesseract-OCR\tesseract.exe"
if not defined TESS_EXE if exist "%LOCALAPPDATA%\Programs\Tesseract-OCR\tesseract.exe" set "TESS_EXE=%LOCALAPPDATA%\Programs\Tesseract-OCR\tesseract.exe"
if defined TESS_EXE goto :check_lang

:tess_fail
echo.
echo [ERROR] Tesseract OCR could not be installed. Please photograph this
echo         window and send it to your assistant.
pause
exit /b 1

:check_lang
echo [3/4] Checking the OCR language data (kor, eng, grc, heb)...
call :get_lang kor
call :get_lang eng
call :get_lang grc
call :get_lang heb

if exist "%CACHE_DIR%\hnc2unicode.rb" goto :have_hnc
curl.exe -sL -o "%CACHE_DIR%\hnc2unicode.rb" "https://raw.githubusercontent.com/ddoleye/java-hwp/master/src/main/resources/hnc2unicode.rb"
:have_hnc

set "BAT_SELF=%~f0"
set "PY_V3_PATH=%CACHE_DIR%\all_to_md_v3.py"
set "PS_V3_PATH=%CACHE_DIR%\picker_v3.ps1"

echo Preparing the picker...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p = @(Get-Content -LiteralPath $env:BAT_SELF); $i = [Array]::IndexOf($p, ':: ===PS_B64==='); if ($i -lt 0) { exit 9 }; $b = (($p[($i+1)..($p.Count-1)]) -join '').Trim(); if ($b.Length -lt 100) { exit 8 }; [IO.File]::WriteAllBytes($env:PS_V3_PATH, [Convert]::FromBase64String($b))"
if errorlevel 1 goto :prep_fail

set "ALL2MD_UV=%UV%"
set "ALL2MD_PY=%PY_V3_PATH%"
set "ALL2MD_TESS_EXE=%TESS_EXE%"
set "ALL2MD_TESS_DIR=%TESS_DIR%"
set "ALL2MD_AHWP=%AHWP%"
set "ALL2MD_BAT=%BAT_SELF%"
set "ALL2MD_STATE=%TEMP%\all_to_md_v3_target.txt"

echo Starting...
if "%~1"=="" goto :launch_plain
powershell -NoProfile -STA -ExecutionPolicy Bypass -File "%PS_V3_PATH%" -Target "%~1"
goto :after_run

:launch_plain
powershell -NoProfile -STA -ExecutionPolicy Bypass -File "%PS_V3_PATH%"

:after_run
if errorlevel 1 goto :run_fail
goto :all_done

:prep_fail
echo.
echo [ERROR] The picker could not be prepared. Please photograph this
echo         window and send it to your assistant.
pause
exit /b 1

:run_fail
echo.
echo [ERROR] The converter stopped with an error. Please photograph the
echo         text above and send it to your assistant.
pause
exit /b 1

:all_done
echo.
pause
exit /b 0

:get_lang
if exist "%TESS_DIR%\%~1.traineddata" goto :eof
echo Downloading %~1.traineddata...
curl.exe -L -f --progress-bar -o "%TESS_DIR%\%~1.traineddata" "https://github.com/tesseract-ocr/tessdata_best/raw/main/%~1.traineddata"
goto :eof
